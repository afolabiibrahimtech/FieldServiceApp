@model IEnumerable<FieldServiceApp.Models.WorkOrder>
<h2>All Work Orders</h2>
<a asp-action="Create" asp-controller="WorkOrder">Create New Work Order</a>
<table border="1">
    <thead>
        <tr>
            <th> <strong>Job Title</strong> </th>
            <th><strong>Priority</strong></th>
            <th><strong>Status</strong></th>
            <th><strong>Assigned To</strong></th>
            <th><strong>Date Created</strong></th>
            <th><strong>Actions</strong></th>
            
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.JobTitle</td>
                <td>@item.Priority</td>
                <td>@item.Status</td>
                <td>@item.AssignedTo</td>
                <td>@item.DateCreated</td>
                <td>
                    <a asp-action="Details" asp-controller="WorkOrder" asp-route-id="@item.ID">Details</a> |
                    <a asp-action="Edit" asp-controller="WorkOrder" asp-route-id="@item.ID">Edit</a> |
                    <a asp-action="Delete" asp-controller="WorkOrder" asp-route-id="@item.ID">Delete</a>
               </td>            
            </tr>
        }
  </tbody>
    
</table>