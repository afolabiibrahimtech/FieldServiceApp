@model IEnumerable<FieldServiceApp.Models.WorkOrder>
@{
    ViewData["Title"] = "Work Orders";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Supervisor");
}

@functions {
    string PriorityBadge(FieldServiceApp.Models.Priority p) => p switch
    {
        FieldServiceApp.Models.Priority.Low => "bg-secondary",
        FieldServiceApp.Models.Priority.Medium => "bg-info text-dark",
        FieldServiceApp.Models.Priority.High => "bg-warning text-dark",
        FieldServiceApp.Models.Priority.Urgent => "bg-danger",
        _ => "bg-secondary"
    };

    string StatusBadge(FieldServiceApp.Models.Status s) => s switch
    {
        FieldServiceApp.Models.Status.Open => "bg-primary",
        FieldServiceApp.Models.Status.InProgress => "bg-warning text-dark",
        FieldServiceApp.Models.Status.Completed => "bg-success",
        FieldServiceApp.Models.Status.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">All Work Orders</h2>
    @if (canManage)
    {
        <a asp-action="Create" asp-controller="WorkOrder" class="btn btn-primary">+ Create New Work Order</a>
    }
</div>

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" id="titleSearch" class="form-control" placeholder="Search by job title" />
    </div>
    <div class="col-md-3">
        <select id="assignFilter" class="form-select">
            <option value="all">All work orders</option>
            <option value="assigned">Assigned</option>
            <option value="unassigned">Unassigned</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Job Title</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Assigned To</th>
                <th>Date Created</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="order-row"
                    data-title="@((item.JobTitle ?? "").ToLower())"
                    data-assigned="@(item.AssignedTo == null ? "unassigned" : "assigned")">
                    <td class="text-muted">@item.ID</td>
                    <td class="fw-semibold">
                        @item.JobTitle
                        @if (!string.IsNullOrWhiteSpace(item.TechnicianNotes))
                        {
                            <span class="badge bg-info text-dark ms-1">Note</span>
                        }
                    </td>
                    <td><span class="badge @PriorityBadge(item.Priority)">@item.Priority</span></td>
                    <td><span class="badge @StatusBadge(item.Status)">@item.Status</span></td>
                    <td>
                        @if (item.AssignedTo == null)
                        {
                            <span class="text-muted">Unassigned</span>
                        }
                        else if (string.IsNullOrEmpty(item.AssignedTo.FullName))
                        {
                            @item.AssignedTo.Email
                        }
                        else
                        {
                            <div>@item.AssignedTo.FullName</div>
                            <div class="small text-muted">@item.AssignedTo.Email</div>
                        }
                    </td>
                    <td>@item.DateCreated.ToString("MMM dd, yyyy h:mm tt")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-controller="WorkOrder" asp-route-id="@item.ID" class="btn btn-sm btn-outline-secondary">Details</a>
                        @if (canManage)
                        {
                            <a asp-action="Edit" asp-controller="WorkOrder" asp-route-id="@item.ID" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-controller="WorkOrder" asp-route-id="@item.ID" class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p id="noResults" class="text-muted text-center" style="display:none">No work orders match.</p>

@if (!Model.Any())
{
    <p class="text-muted text-center">No work orders yet.</p>
}

@section Scripts {
    <script>
        var titleSearch = document.getElementById("titleSearch");
        var assignFilter = document.getElementById("assignFilter");
        var rows = document.querySelectorAll(".order-row");
        var noResults = document.getElementById("noResults");

        function applyFilters() {
            var term = titleSearch.value.toLowerCase().trim();
            var assigned = assignFilter.value;
            var shown = 0;

            rows.forEach(function (row) {
                var titleOk = row.dataset.title.includes(term);
                var assignOk = assigned === "all" || row.dataset.assigned === assigned;
                var show = titleOk && assignOk;
                row.style.display = show ? "" : "none";
                if (show) shown++;
            });

            noResults.style.display = (rows.length > 0 && shown === 0) ? "" : "none";
        }

        titleSearch.addEventListener("input", applyFilters);
        assignFilter.addEventListener("change", applyFilters);
    </script>
}