@model FieldServiceApp.ViewModels.WorkOrderViewModel
@{
    ViewData["Title"] = "Edit Work Order";
}

<h3 class="mb-3">Edit Work Order</h3>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Edit" asp-controller="WorkOrder" method="post" style="max-width:600px">
    <div class="mb-3">
        <label asp-for="JobTitle" class="form-label">Job Title</label>
        <input asp-for="JobTitle" class="form-control" placeholder="Job title" required />
        <span asp-validation-for="JobTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4" placeholder="What needs to be done?" required></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Priority" class="form-label">Priority</label>
            <select asp-for="Priority" class="form-select"
                    asp-items="Html.GetEnumSelectList<FieldServiceApp.Models.Priority>()"></select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select"
                    asp-items="Html.GetEnumSelectList<FieldServiceApp.Models.Status>()"></select>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="AssignedToId" class="form-label">Assigned To</label>
        <select asp-for="AssignedToId" class="form-select" asp-items="@((SelectList)ViewBag.Users)">
            <option value="">-- Unassigned --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" asp-controller="WorkOrder" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}