@model FieldServiceApp.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit Name";
}

<h2 class="mb-3">Edit Name</h2>
<p class="text-muted">@Model.Email</p>

<form asp-action="EditName" asp-route-id="@Model.Id" method="post" style="max-width:400px">
    <div class="mb-3">
        <label class="form-label" for="firstName">First Name</label>
        <input type="text" id="firstName" name="firstName" value="@Model.FirstName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="lastName">Last Name</label>
        <input type="text" id="lastName" name="lastName" value="@Model.LastName" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>