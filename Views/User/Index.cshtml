@model List<FieldServiceApp.Models.ApplicationUser>
@using FieldServiceApp.Models
@{
    ViewData["Title"] = "Users";
}

<h2 class="mb-3">Users</h2>

<div class="mb-3 col-md-5 px-0">
    <input type="text" id="userSearch" class="form-control" placeholder="Search by name or email" />
</div>

<table class="table table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Current Role</th>
            <th>Change Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr class="user-row" data-search="@((user.FullName + " " + user.Email).ToLower())">
                <td>
                    @if (string.IsNullOrEmpty(user.FullName))
                    {
                        <span class="text-muted">(no name yet)</span>
                    }
                    else
                    {
                        @user.FullName
                    }
                    <a asp-action="EditName" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary ms-2">Edit</a>
                </td>
                <td>@user.Email</td>
                <td><span class="badge bg-secondary">@user.Role</span></td>
                <td>
                    <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@user.Id" />
                        <select name="role" class="form-select form-select-sm w-auto">
                            @foreach (var r in Enum.GetValues<UserRole>())
                            {
                                <option value="@r" selected="@(user.Role == r)">@r</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<p id="noResults" class="text-muted" style="display:none">No users found.</p>

@section Scripts {
    <script>
        var searchBox = document.getElementById("userSearch");
        var rows = document.querySelectorAll(".user-row");
        var noResults = document.getElementById("noResults");

        searchBox.addEventListener("input", function () {
            var term = searchBox.value.toLowerCase().trim();
            var shown = 0;

            rows.forEach(function (row) {
                var match = row.dataset.search.includes(term);
                row.style.display = match ? "" : "none";
                if (match) shown++;
            });

            noResults.style.display = shown === 0 ? "" : "none";
        });
    </script>
}