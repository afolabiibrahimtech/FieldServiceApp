@model FieldServiceApp.ViewModels.RegisterViewModel
<h6> Register </h6>
<div asp-validation-summary="All" style="color:red"></div>
<form asp-action="Register" asp-controller="Account" method="post">
  <label for="FirstName">First Name:</label><br>
  <input type="text" asp-for="FirstName" placeholder="Enter your first name" required>
  <span asp-validation-for="FirstName" style="color:red"></span><br>

  <label for="LastName">Last Name:</label><br>
  <input type="text" asp-for="LastName" placeholder="Enter your last name" required>
  <span asp-validation-for="LastName" style="color:red"></span><br>

  <label for="Email">Email:</label><br>
  <input type="email" asp-for="Email" placeholder="Enter your email" required>
  <span asp-validation-for="Email" style="color:red"></span><br>

  <label for="Password">Password:</label><br>
  <input type="password" asp-for="Password" placeholder="Min 6 chars: A-Z, a-z, 0-9, symbol" required>
  <span asp-validation-for="Password" style="color:red"></span><br>
  <small>Must include an uppercase letter, a lowercase letter, a number and a symbol (e.g. Test@1234)</small><br>

  <label for="ConfirmPassword">Confirm Password:</label><br>
  <input type="password" asp-for="ConfirmPassword" placeholder="Re-enter your password" required>
  <span asp-validation-for="ConfirmPassword" style="color:red"></span><br>

  <label for="Role">Role:</label><br>
  <select asp-for="Role" asp-items="Html.GetEnumSelectList<FieldServiceApp.Models.UserRole>()" required></select>
  <br>
  <button type="submit">Submit</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}