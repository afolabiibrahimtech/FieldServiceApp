@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4">Field Service Work Orders</h1>
    <p class="lead text-muted">Create jobs, assign them to technicians and track them until they're done.</p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <p>Welcome back, @User.Identity.Name</p>

        @if (User.IsInRole("Technician"))
        {
            <a class="btn btn-primary" asp-controller="WorkOrder" asp-action="MyJobs">My Jobs</a>
            <a class="btn btn-outline-primary" asp-controller="WorkOrderRequest" asp-action="Available">Available Work</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="WorkOrder" asp-action="Index">View Work Orders</a>
        }
    }
    else
    {
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Login</a>
        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Register</a>
    }
</div>